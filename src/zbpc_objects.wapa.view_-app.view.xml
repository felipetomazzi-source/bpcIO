<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core"                                                                                                                                                                                   
  controllerName="chorus.bpc.objects.controller.App" displayBlock="true">                                                                                                                                                                                      
  <App id="app">                                                                                                                                                                                                                                               
    <Page id="mainPage" title="BPC Object Manager" busy="{bpc>/busy}" busyIndicatorDelay="0">                                                                                                                                                                  
      <content>                                                                                                                                                                                                                                                
        <VBox class="sapUiMediumMargin">                                                                                                                                                                                                                       
          <Label text="Environment" labelFor="environment" />                                                                                                                                                                                                  
          <Select id="environment" width="100%" forceSelection="false" change="onEnvironmentChange"                                                                                                                                                            
            selectedKey="{bpc>/environment}" items="{bpc>/environments}">                                                                                                                                                                                      
            <core:Item key="{bpc>id}" text="{bpc>id}" />                                                                                                                                                                                                       
          </Select>                                                                                                                                                                                                                                            
          <Label text="Model" labelFor="model" class="sapUiMediumMarginTop" />                                                                                                                                                                                 
          <Select id="model" width="100%" forceSelection="false" change="onModelChange"                                                                                                                                                                        
            selectedKey="{bpc>/model}" items="{bpc>/models}">                                                                                                                                                                                                  
            <core:Item key="{bpc>id}" text="{bpc>id}" />                                                                                                                                                                                                       
          </Select>                                                                                                                                                                                                                                            
          <OverflowToolbar class="sapUiMediumMarginTop">                                                                                                                                                                                                       
            <Button text="Select all" press="onSelectAll" enabled="{bpc>/objectsLoaded}" />                                                                                                                                                                    
            <Button text="Clear selection" press="onClearSelection" enabled="{bpc>/objectsLoaded}" />                                                                                                                                                          
            <ToolbarSpacer />                                                                                                                                                                                                                                  
            <Button text="Refresh" icon="sap-icon://refresh" press="onRefresh" enabled="{= !!${bpc>/model} }" />                                                                                                                                               
            <Button text="Export selected" icon="sap-icon://download" type="Emphasized" press="onExport"                                                                                                                                                       
              enabled="{= ${bpc>/selectedCount} > 0 }" />                                                                                                                                                                                                      
            <Button text="Import archive" icon="sap-icon://upload" press="onUpload" enabled="{= !!${bpc>/model} }" />                                                                                                                                          
          </OverflowToolbar>                                                                                                                                                                                                                                   
          <Text text="{= ${bpc>/selectedCount} + ' object(s) selected' }" class="sapUiSmallMarginTop" />                                                                                                                                                       
          <List id="objects" items="{bpc>/objects}" mode="MultiSelect" includeItemInSelection="true"                                                                                                                                                           
            rememberSelections="false" selectionChange="onObjectsSelection" showGroupHeaders="true"                                                                                                                                                            
            noDataText="No Logic Scripts or Data Manager Packages to display.">                                                                                                                                                                                
            <StandardListItem title="{bpc>title}" description="{bpc>description}" info="{bpc>info}" />                                                                                                                                                         
          </List>                                                                                                                                                                                                                                              
          <Text text="{bpc>/status}" class="sapUiSmallMarginTop" />                                                                                                                                                                                            
        </VBox>                                                                                                                                                                                                                                                
      </content>                                                                                                                                                                                                                                               
    </Page>                                                                                                                                                                                                                                                    
    <Page id="comparePage" title="Import preview" showNavButton="true" navButtonPress="onBack">                                                                                                                                                                
      <content>                                                                                                                                                                                                                                                
        <VBox class="sapUiMediumMargin">                                                                                                                                                                                                                       
          <MessageStrip text="Import writes the uploaded objects into the selected model. Validate Logic Scripts in BPC before executing them."                                                                                                                
            showIcon="true" type="Information" />                                                                                                                                                                                                              
          <Text text="{bpc>/archiveSource}" class="sapUiSmallMarginTopBottom" />                                                                                                                                                                               
          <Title text="Logic Scripts" level="H2" class="sapUiMediumMarginTop" visible="{= ${bpc>/uploaded}.length > 0 }" />                                                                                                                                    
          <Text text="This archive contains no Logic Scripts." visible="{= !${bpc>/uploaded}.length }" class="sapUiSmallMarginBottom" />                                                                                                                       
          <List id="uploadedScripts" items="{bpc>/uploaded}" mode="SingleSelectMaster" includeItemInSelection="true"                                                                                                                                           
            rememberSelections="false" selectionChange="onUploadedSelect" growing="true" growingThreshold="20"                                                                                                                                                 
            visible="{= ${bpc>/uploaded}.length > 0 }">                                                                                                                                                                                                        
            <StandardListItem title="{bpc>name}" info="{bpc>status}" />                                                                                                                                                                                        
          </List>                                                                                                                                                                                                                                              
          <Title text="Data Manager Packages" level="H2" class="sapUiMediumMarginTop" visible="{= ${bpc>/archivePackages}.length > 0 }" />                                                                                                                     
          <List id="uploadedPackages" items="{bpc>/archivePackages}" visible="{= ${bpc>/archivePackages}.length > 0 }">                                                                                                                                        
            <StandardListItem title="{bpc>id}" description="{bpc>description}" info="{bpc>group}" />                                                                                                                                                           
          </List>                                                                                                                                                                                                                                              
          <OverflowToolbar class="sapUiMediumMarginTop">                                                                                                                                                                                                       
            <CheckBox id="replaceExisting" text="Replace existing scripts" visible="{= ${bpc>/uploaded}.length > 0 }" />                                                                                                                                       
            <CheckBox id="replacePackages" text="Replace existing packages" visible="{= ${bpc>/archivePackages}.length > 0 }" />                                                                                                                               
            <ToolbarSpacer />                                                                                                                                                                                                                                  
            <Button text="Import into SAP" icon="sap-icon://accept" type="Emphasized" press="onImport"                                                                                                                                                         
              enabled="{= (${bpc>/uploaded}.length + ${bpc>/archivePackages}.length) > 0 &amp;&amp; !${bpc>/busy} }" />                                                                                                                                        
          </OverflowToolbar>                                                                                                                                                                                                                                   
          <Text text="{bpc>/importSummary}" class="sapUiSmallMarginTop" />                                                                                                                                                                                     
          <Text text="{bpc>/packageImportSummary}" class="sapUiSmallMarginTop" />                                                                                                                                                                              
          <List id="importResults" items="{bpc>/importResults}" visible="{= ${bpc>/importResults}.length > 0 }">                                                                                                                                               
            <StandardListItem title="{bpc>name}" info="{bpc>action}" description="{bpc>message}" />                                                                                                                                                            
          </List>                                                                                                                                                                                                                                              
          <Title text="{bpc>/compareTitle}" level="H2" class="sapUiMediumMarginTop" visible="{= ${bpc>/uploaded}.length > 0 }" />                                                                                                                              
          <Text text="{bpc>/compareStatus}" class="sapUiSmallMarginBottom" visible="{= ${bpc>/uploaded}.length > 0 }" />                                                                                                                                       
          <HBox width="100%" wrap="Wrap" class="bpcComparison" visible="{= ${bpc>/uploaded}.length > 0 }">                                                                                                                                                     
            <VBox width="50%" class="bpcCompareColumn">                                                                                                                                                                                                        
              <Label text="Uploaded version" labelFor="uploadedContent" design="Bold" />                                                                                                                                                                       
              <TextArea id="uploadedContent" value="{bpc>/uploadedText}" editable="false" width="100%" height="28rem" class="bpcSource" />                                                                                                                     
            </VBox>                                                                                                                                                                                                                                            
            <VBox width="50%" class="bpcCompareColumn" busy="{bpc>/previewBusy}" busyIndicatorDelay="0">                                                                                                                                                       
              <Label text="Active SAP version" labelFor="activeContent" design="Bold" />                                                                                                                                                                       
              <TextArea id="activeContent" value="{bpc>/activeText}" editable="false" width="100%" height="28rem" class="bpcSource" />                                                                                                                         
            </VBox>                                                                                                                                                                                                                                            
          </HBox>                                                                                                                                                                                                                                              
        </VBox>                                                                                                                                                                                                                                                
      </content>                                                                                                                                                                                                                                               
    </Page>                                                                                                                                                                                                                                                    
  </App>                                                                                                                                                                                                                                                       
</mvc:View>                                                                                                                                                                                                                                                    