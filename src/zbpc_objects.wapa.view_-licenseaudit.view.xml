<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core"                                                                                                                                                                                   
  controllerName="chorus.bpc.objects.controller.LicenseAudit">                                                                                                                                                                                                 
  <VBox class="sapUiMediumMargin" busy="{audit>/busy}" busyIndicatorDelay="0">                                                                                                                                                                                 
    <Text text="BPC license usage across all environments in this SAP client, measured using SAP's audit rules." />                                                                                                                                            
    <HBox alignItems="End" wrap="Wrap" class="sapUiMediumMarginTop sapUiMediumMarginBottom">                                                                                                                                                                   
      <VBox class="sapUiSmallMarginEnd">                                                                                                                                                                                                                       
        <Label text="Analysis start date" labelFor="auditStartDate" />                                                                                                                                                                                         
        <DatePicker id="auditStartDate" value="{audit>/startDate}" valueFormat="yyyyMMdd" displayFormat="yyyy-MM-dd"                                                                                                                                           
          placeholder="Default: last 365 days" change="onStartDateChange" enabled="{= !${audit>/busy} }" />                                                                                                                                                    
      </VBox>                                                                                                                                                                                                                                                  
      <Button text="Analyse licenses" icon="sap-icon://inspect" type="Emphasized" press="onAnalyse" enabled="{= !${audit>/busy} }" />                                                                                                                          
    </HBox>                                                                                                                                                                                                                                                    
    <Text text="{audit>/period}" visible="{audit>/loaded}" class="sapUiSmallMarginBottom" />                                                                                                                                                                   
    <VBox visible="{audit>/loaded}">                                                                                                                                                                                                                           
      <Label text="Account status" labelFor="auditAccountStatus" />                                                                                                                                                                                            
      <Select id="auditAccountStatus" selectedKey="{audit>/accountStatus}" change="onFilter" width="16rem">                                                                                                                                                    
        <core:Item key="Active" text="Active accounts" />                                                                                                                                                                                                      
        <core:Item key="Inactive" text="Inactive accounts" />                                                                                                                                                                                                  
      </Select>                                                                                                                                                                                                                                                
      <Text text="Active means currently unlocked and unexpired in SAP. Inactive accounts are reported separately." class="sapUiSmallMarginTopBottom" />                                                                                                       
      <HBox wrap="Wrap">                                                                                                                                                                                                                                       
        <GenericTile id="professionalTile" header="Professional" subheader="{audit>/accountStatus}" press="onProfessional"                                                                                                                                     
          class="sapUiTinyMarginEnd sapUiTinyMarginBottom bpcLaunchTile">                                                                                                                                                                                      
          <TileContent footer="Select to see users and qualifying activities">                                                                                                                                                                                 
            <NumericContent value="{audit>/professional}" icon="sap-icon://person-placeholder" truncateValueTo="10" />                                                                                                                                         
          </TileContent>                                                                                                                                                                                                                                       
        </GenericTile>                                                                                                                                                                                                                                         
        <GenericTile id="standardTile" header="Standard" subheader="{audit>/accountStatus}" press="onStandard"                                                                                                                                                 
          class="sapUiTinyMarginEnd sapUiTinyMarginBottom bpcLaunchTile">                                                                                                                                                                                      
          <TileContent footer="Select to see users and last recorded access">                                                                                                                                                                                  
            <NumericContent value="{audit>/standard}" icon="sap-icon://group" truncateValueTo="10" />                                                                                                                                                          
          </TileContent>                                                                                                                                                                                                                                       
        </GenericTile>                                                                                                                                                                                                                                         
      </HBox>                                                                                                                                                                                                                                                  
      <Text text="Professional takes precedence over Standard. Qualifying activity can be earlier than the user's latest access." class="sapUiSmallMarginTopBottom" />                                                                                         
      <Text text="SAP retains the latest date per activity, rather than a complete event history. Dates and counts depend on retained audit records." class="sapUiSmallMarginBottom" />                                                                        
      <Toolbar>                                                                                                                                                                                                                                                
        <Title text="Users" level="H2" />                                                                                                                                                                                                                      
        <Select selectedKey="{audit>/license}" change="onFilter" width="10rem">                                                                                                                                                                                
          <core:Item key="All" text="All licenses" />                                                                                                                                                                                                          
          <core:Item key="Professional" text="Professional" />                                                                                                                                                                                                 
          <core:Item key="Standard" text="Standard" />                                                                                                                                                                                                         
        </Select>                                                                                                                                                                                                                                              
        <ToolbarSpacer />                                                                                                                                                                                                                                      
        <SearchField value="{audit>/search}" liveChange="onFilter" search="onFilter" width="18rem" placeholder="Search users or activities" />                                                                                                                 
      </Toolbar>                                                                                                                                                                                                                                               
      <Table items="{audit>/rows}" growing="true" growingThreshold="50" noDataText="No users match this selection.">                                                                                                                                           
        <columns>                                                                                                                                                                                                                                              
          <Column><Text text="User" /></Column>                                                                                                                                                                                                                
          <Column minScreenWidth="Tablet" demandPopin="true"><Text text="License" /></Column>                                                                                                                                                                  
          <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Last recorded access" /></Column>                                                                                                                                                     
          <Column minScreenWidth="Desktop" demandPopin="true"><Text text="Qualifying activity" /></Column>                                                                                                                                                     
          <Column minScreenWidth="Desktop" demandPopin="true"><Text text="Activity date" /></Column>                                                                                                                                                           
        </columns>                                                                                                                                                                                                                                             
        <items>                                                                                                                                                                                                                                                
          <ColumnListItem type="Navigation" press="onUserPress">                                                                                                                                                                                               
            <cells>                                                                                                                                                                                                                                            
              <Text text="{audit>userId}" />                                                                                                                                                                                                                   
              <Text text="{audit>license}" />                                                                                                                                                                                                                  
              <Text text="{audit>lastAccess}" />                                                                                                                                                                                                               
              <Text text="{audit>activityLabel}" />                                                                                                                                                                                                            
              <Text text="{audit>qualifyingDate}" />                                                                                                                                                                                                           
            </cells>                                                                                                                                                                                                                                           
          </ColumnListItem>                                                                                                                                                                                                                                    
        </items>                                                                                                                                                                                                                                               
      </Table>                                                                                                                                                                                                                                                 
    </VBox>                                                                                                                                                                                                                                                    
  </VBox>                                                                                                                                                                                                                                                      
  <mvc:dependents>                                                                                                                                                                                                                                             
    <Dialog id="userDialog" title="{= 'License audit: ' + ${audit>/selected/userId} }" contentWidth="40rem" draggable="true" resizable="true">                                                                                                                 
      <content>                                                                                                                                                                                                                                                
        <VBox class="sapUiMediumMargin">                                                                                                                                                                                                                       
          <Label text="License / account status" /><Text text="{= ${audit>/selected/license} + ' / ' + ${audit>/selected/accountStatus} }" />                                                                                                                  
          <Label text="Last recorded access in the analysis period" class="sapUiSmallMarginTop" /><Text text="{audit>/selected/lastAccess}" />                                                                                                                 
          <Label text="Activity determining license classification" class="sapUiSmallMarginTop" /><Text text="{audit>/selected/activityLabel}" />                                                                                                              
          <Text text="{audit>/selected/activity}" />                                                                                                                                                                                                           
          <Label text="Qualifying activity date" class="sapUiSmallMarginTop" /><Text text="{audit>/selected/qualifyingDate}" />                                                                                                                                
          <Label text="Environment of qualifying activity" class="sapUiSmallMarginTop" /><Text text="{audit>/selected/environment}" />                                                                                                                         
          <Label text="Audit source" class="sapUiSmallMarginTop" /><Text text="{audit>/selected/source}" />                                                                                                                                                    
        </VBox>                                                                                                                                                                                                                                                
      </content>                                                                                                                                                                                                                                               
      <endButton><Button text="Close" press="onCloseUser" /></endButton>                                                                                                                                                                                       
    </Dialog>                                                                                                                                                                                                                                                  
  </mvc:dependents>                                                                                                                                                                                                                                            
</mvc:View>                                                                                                                                                                                                                                                    